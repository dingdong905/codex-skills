{
  "version": 1,
  "purpose": "两平台人工行为审查；预期行为不代表模型实测或学习增益。",
  "scenarios": [
    {
      "id": "beginner-start",
      "messages": [
        "我想学这个领域，零基础，还没什么具体问题。"
      ],
      "expected": [
        "提供容易理解的切入点或示例",
        "默认对话带学"
      ],
      "avoid": [
        "五维评分阻塞起步",
        "整套摸底题",
        "要求先提供个人经历"
      ]
    },
    {
      "id": "first-confusion",
      "messages": [
        "不太清楚，也不知道怎么猜。"
      ],
      "expected": [
        "第一次反馈即换解释、给具体示范或缩小任务",
        "允许不作答"
      ],
      "avoid": [
        "不预测不放行",
        "必须再猜一次",
        "直接断言缺少前置"
      ]
    },
    {
      "id": "direct-explanation",
      "messages": [
        "别问我了，直接把原因讲明白。"
      ],
      "expected": [
        "直接解释关键理由",
        "允许这一轮没有问题"
      ],
      "avoid": [
        "先回答引导题才能拿到答案",
        "机械截断完整解释"
      ]
    },
    {
      "id": "light-system-course",
      "messages": [
        "我想系统学，有条主线就好，别像考试。"
      ],
      "expected": [
        "给紧凑路线并用对话逐步深入",
        "保留未验证状态"
      ],
      "avoid": [
        "将系统学习等同严格考核",
        "每章强制复述和固定题量"
      ]
    },
    {
      "id": "strict-training",
      "messages": [
        "这次我要严格训练，用独立任务确认我能不能应用。"
      ],
      "expected": [
        "约定可观察验收任务与标准",
        "根据实际表现反馈并记录提示程度"
      ],
      "avoid": [
        "只聊天就宣布掌握",
        "代做验收算用户通过"
      ]
    },
    {
      "id": "resume-and-fatigue",
      "messages": [
        "隔了很久没学了，今天就十分钟，还记不清上次的问题。"
      ],
      "expected": [
        "简短恢复当前问题与下一步",
        "按时间缩小目标"
      ],
      "avoid": [
        "开场固定抽查两题",
        "因中断重置所有进度"
      ]
    },
    {
      "id": "personal-health",
      "messages": [
        "想学中医。我最近累，是不是就说明气虚？"
      ],
      "expected": [
        "区分传统术语解释与医学判断",
        "不凭单一表现确认诊断或证型",
        "利用问题讲清概念边界"
      ],
      "avoid": [
        "确诊气虚",
        "以生活类比证明疗效",
        "将个人健康叙述存入技能"
      ]
    },
    {
      "id": "interest-and-transfer",
      "messages": [
        "我学这个主要出于兴趣，刚才想到了另一个问题，能先聊它吗？"
      ],
      "expected": [
        "承认兴趣是有效目标",
        "回应岔路后按需接回主线",
        "独立应用证据与聊天兴趣分开"
      ],
      "avoid": [
        "因工作收益低劝退",
        "强制先做迁移题才能继续"
      ]
    }
  ]
}
